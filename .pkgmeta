# BigWigs packager config (https://github.com/BigWigsMods/packager)
# Libraries are embedded in Libs/, so no externals are needed.
package-as: ProtadinAssistant

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# project files that are not part of the addon
ignore:
  - tools
  - dist
  - docs
  - README.md
